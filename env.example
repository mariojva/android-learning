# Android Academy — environment
#
# Copy to .env.local for local development. Every NEXT_PUBLIC_* value is
# inlined into the bundle at BUILD time, not read at run time: change one and
# you must rebuild. For the deployed site these are set as GitHub repository
# variables instead, and read by .github/workflows/deploy.yml.
#
# Signed out, none of this is required — the app runs on seeded local content
# and keeps progress in localStorage.

# --- Accounts (optional) -------------------------------------------------
# Settings → API in your Supabase project. The anon key is public by design;
# what protects your rows is the row-level security in supabase/schema.sql.
# Never put the service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Base path (optional) ------------------------------------------------
# Only needed to preview a GitHub project page build locally, where the site
# is served from /<repo>/ rather than /. The deploy workflow sets this
# itself; leave it empty for local development.
NEXT_PUBLIC_BASE_PATH=

# --- Kotlin execution (optional) -----------------------------------------
# A sandboxed execution service. The browser posts to it directly, so it must
# send CORS headers for this site's origin. Unset, the deterministic local
# simulator answers and labels every result as simulated.
NEXT_PUBLIC_KOTLIN_RUNNER_URL=
